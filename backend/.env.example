# Conexão com o PostgreSQL. Ao rodar via Docker Compose, POSTGRES_HOST é
# substituído automaticamente por "db" (nome do serviço do banco).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gerenciador_empresas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Opcional: string de conexão completa (tem prioridade sobre as variáveis acima).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gerenciador_empresas

# Origens liberadas no CORS, separadas por vírgula (ex.: http://localhost:5173).
CORS_ORIGINS=*

# 1 ativa o modo debug do Flask (recarrega ao salvar arquivos).
FLASK_DEBUG=0
